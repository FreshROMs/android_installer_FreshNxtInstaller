###
# Compatibility check
ui_print("- " + file_getprop("/tmp/fresh/lang.prop", "script.check.compatibility"));
run_program("/tmp/fresh/tools/fresh-tk", "device_check");
run_program("/tmp/fresh/tools/fresh-tk", "part_check");

ifelse(
  file_getprop("/tmp/fresh/toolkit.prop", "device.model") == "fail", (
    ui_print("   - " + file_getprop("/tmp/fresh/lang.prop", "script.check.device.fail1"));
    ui_print("     " + file_getprop("/tmp/fresh/lang.prop", "script.check.device.fail2"));
    ui_print("     " + file_getprop("/tmp/fresh/package.prop", "pkg.models"));
    sleep(4);
    abort(" ");
   ), (
    ui_print("   - " + file_getprop("/tmp/fresh/toolkit.prop", "device.model") + " " + file_getprop("/tmp/fresh/lang.prop", "script.check.device.success"));
   )
);

ifelse(
  file_getprop("/tmp/fresh/toolkit.prop", "part.check") == "fail", (
    ui_print("   - " + file_getprop("/tmp/fresh/lang.prop", "script.check.partitions.fail1"));
    ui_print("     " + file_getprop("/tmp/fresh/lang.prop", "script.check.partitions.fail1"));
    sleep(4);
    abort(" ");
   ), (
    ui_print("   - " + file_getprop("/tmp/fresh/lang.prop", "script.check.partitions.success"));
   )
);

ui_print(" ");

###
# Unmount partitions
ui_print("- " + file_getprop("/tmp/fresh/lang.prop", "script.partitions.unmount"));
ifelse(is_mounted("/system_root"), unmount("/system_root"));
ifelse(is_mounted("/system"), unmount("/system"));
ifelse(is_mounted("/vendor"), unmount("/vendor"));
ifelse(is_mounted("/product"), unmount("/product"));
ifelse(is_mounted("/odm"), unmount("/odm"));
ifelse(is_mounted("/prism"), unmount("/prism"));
ifelse(is_mounted("/optics"), unmount("/optics"));
ifelse(is_mounted("/system_dlkm"), unmount("/system_dlkm"));
ifelse(is_mounted("/vendor_dlkm"), unmount("/vendor_dlkm"));

###
# Flash OS partitions
ui_print("- " + file_getprop("/tmp/fresh/lang.prop", "script.install.main"));
if file_getprop("/tmp/fresh/package.prop", "pkg.has_super_empty") == "true"; then
  ui_print("   - " + file_getprop("/tmp/fresh/lang.prop", "script.install.super"));
  assert(update_dynamic_partitions(package_extract_file("dynamic_partitions_op_list")));
  package_extract_file("super_empty.img", "/dev/block/bootdevice/by-name/super");
endif;
if file_getprop("/tmp/fresh/package.prop", "pkg.has_system") == "true"; then
  ui_print("   - " + file_getprop("/tmp/fresh/lang.prop", "script.install.system"));
  block_image_update(file_getprop("/tmp/fresh/toolkit.prop", "part.block.system"), package_extract_file("system.transfer.list"), "system.new.dat.br", "system.patch.dat") || abort("      - Failed to update system image!");
endif;
if file_getprop("/tmp/fresh/package.prop", "pkg.has_vendor") == "true"; then
  ui_print("   - " + file_getprop("/tmp/fresh/lang.prop", "script.install.vendor"));
