###
# 0 - Prepare installer
resexec("tools/fresh-tk", "mkdir -p /tmp/fresh/tools");
restotmp("tools/busybox", "/fresh/tools/busybox");
restotmp("tools/fresh-tk", "/fresh/tools/fresh-tk");
ziptotmp("package.prop", "/fresh/package.prop");

#-- Set colorspace and theme
ini_set("force_colorspace","rgba");
theme("fresh");

#-- Show splash screen
splash(2000, "splash/setup_splash_fresh_six");

#-- Set font styles and font sizes
fontresload( "0", "ttf/SEC-Regular.ttf;ttf/NotoSansTaiViet-Regular.ttf;ttf/DroidSansFallback.ttf;ttf/DroidSansArabic.ttf;", "12" );
fontresload( "1", "ttf/SEC-Medium.ttf;ttf/NotoSansTaiViet-Regular.ttf;ttf/DroidSansFallback.ttf;ttf/DroidSansArabic.ttf;", "16" );
fontresload( "2", "ttf/SEC-Light.ttf;ttf/NotoSansTaiViet-Regular.ttf;ttf/DroidSansFallback.ttf;ttf/DroidSansArabic.ttf;", "18" );

#-- Load default language before selection
loadlang("strings/en.lang");

###
# 1 - Language picker
include("modules/select_language.edify");

###
# 2 - Welcome screen
viewbox(
    "<~welcome.title>",

    "<@center><~welcome.text1></@>\n\n" +
    "<@center><~welcome.text2></@>\n\n\n\n" +
    "<@center><~welcome.text3></@>",

    "@brand"
);

###
# 3 - ToS and privacy policy screen
agreebox(
    "<~terms.title>",
    "<~terms.summary>",
    "@terms",
    resread("text/tos.txt"),
    "<~terms.check>",
    "<~terms.confirm>"
);

###
# 4 - Install menu screen
pleasewait("<~wait.install.scan>");
resexec("tools/fresh-tk", "part_check");
resexec("tools/fresh-tk", "mkdir -p /system_root");
resexec("tools/fresh-tk", "mount -t ext4 " + file_getprop("/tmp/fresh/toolkit.prop", "part.block.system") + " /system_root");
resexec("tools/fresh-tk", "mount -t erofs " + file_getprop("/tmp/fresh/toolkit.prop", "part.block.system") + " /system_root");
resexec("tools/fresh-tk", "mkdir -p /omr");
resexec("tools/fresh-tk", "mount -t ext4 " + file_getprop("/tmp/fresh/toolkit.prop", "part.block.omr") + " /omr");
resexec("tools/fresh-tk", "version_check");

if file_getprop("/tmp/fresh/toolkit.prop", "install.type") == "new" then
  menubox(
      "<~menu.title>",
      "<~menu.new.summary>",
      "@install",
      "menu.prop",
      
      "<~menu.express.title>",      "<~menu.express.summary>",        "@install_express",
      "<~menu.custom.title>",       "<~menu.custom.summary>",         "@install_custom"
  );

  #-- Express installation
  if prop("menu.prop","selected") == "1" then
    include("modules/install_express.edify");
  endif;

  #-- Custom installation
  if prop("menu.prop","selected") == "2" then
    include("modules/install_custom.edify");
  endif;

else

  #-- Migrate addon selections from the previous installation
  resexec("tools/fresh-tk", "migrate_addon_list");

  if file_getprop("/tmp/fresh/toolkit.prop", "install.type") == "upgrade" then
    menubox(
        "<~menu.title>",
        "<~menu.current.summary>",
        "@install",
        "menu.prop",
        
        "<~menu.upgrade.title>",      "<~menu.upgrade.summary>",        "@install_upgrade",
        "<~menu.express.title>",      "<~menu.express.summary>",        "@install_express",
        "<~menu.custom.title>",       "<~menu.custom.summary>",         "@install_custom"
    );
  else
    menubox(
        "<~menu.title>",
        "<~menu.current.summary>",
        "@install",
        "menu.prop",
        
        "<~menu.reinstall.title>",    "<~menu.reinstall.summary>",      "@install_reinstall",
        "<~menu.express.title>",      "<~menu.express.summary>",        "@install_express",
        "<~menu.custom.title>",       "<~menu.custom.summary>",         "@install_custom"
    );
  endif;

  #-- Express installation
  if prop("menu.prop","selected") == "2" then
    include("modules/install_express.edify");
  endif;

  #-- Custom installation
  if prop("menu.prop","selected") == "3" then
    include("modules/install_custom.edify");
  endif;

endif;

###
# 5 - Summary screen
pleasewait("<~wait.generic>");
resexec("tools/make-summary");

ini_set("text_next", "<~confirm.next>");

textbox(
    "<~confirm.title>",
    "<~confirm.summary>",
    "@confirm",
    read("/tmp/install-wizard/summary.txt")
);

###
# 6 - Installation screen
ini_set("text_next", "<~text_next>");

setvar("installstatus",
  install(
    "<~install.title>",
    "<~install.summary>",
    "@install",
    "<~install.finish>"
  )
);

###
# 7 - Finish screen
ini_set("text_next", "<~text.exit>");

checkviewbox(
    "<~finish.title>",
  
    "<@center><~finish.text1></@>\n\n" +
    "<@center><~finish.text2></@>\n\n\n\n" +
    "<@center><~finish.text3></@>",

    "@brand",

    "<~finish.button.restart>",
    "0",
    "reboot_after_setup"
);

if getvar("reboot_after_setup") == "1" then
  reboot("onfinish");
endif;
