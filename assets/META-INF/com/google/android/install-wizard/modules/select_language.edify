selectbox(
  "<~lang.title>",
  "<~lang.summary>",
  "@language",
  "language.prop",

  "English",          "Localization by TenSeventy7 and PeterKnecht93", 1,
  "Deutsch",          "Lokalisierung durch Lijukay und PeterKnecht93", 0,
  "Italiano",         "Traduzione fatta da Skizzy5313",                0,
  "Français",         "Localisation par LeSteakDeBoeuf.",              0,
  "Farsi (Pinglish)", "Tarjomeye Farsi az Navid14101",                 0,
  "Suomi",            "Tämän lokalisoinnin tekijä on Finnnishboy",     0,
  "Русский",          "Русификатор - trigger337",                      0,
  "Türkçe",           "duhansysl tarafından Türkçe'ye çevrildi.",      0
);

# Load proper languages
if prop("language.prop","selected.0") == "1" then
  loadlang("strings/en.lang");
  restotmp("strings/en.lang", "/fresh/lang.prop");
endif;

if prop("language.prop","selected.0") == "2" then
  loadlang("strings/de.lang");
  restotmp("strings/de.lang", "/fresh/lang.prop");
endif;

if prop("language.prop","selected.0") == "3" then
  loadlang("strings/it.lang");
  restotmp("strings/it.lang", "/fresh/lang.prop");
endif;

if prop("language.prop","selected.0") == "4" then
  loadlang("strings/fr.lang");
  restotmp("strings/fr.lang", "/fresh/lang.prop");
endif;

if prop("language.prop","selected.0") == "5" then
  loadlang("strings/fa_en.lang");
  restotmp("strings/fa_en.lang", "/fresh/lang.prop");
endif;

if prop("language.prop","selected.0") == "6" then
  loadlang("strings/fi.lang");
  restotmp("strings/fi.lang", "/fresh/lang.prop");
endif;

if prop("language.prop","selected.0") == "7" then
  loadlang("strings/ru.lang");
  restotmp("strings/ru.lang", "/fresh/lang.prop");
endif;

if prop("language.prop","selected.0") == "8" then
  loadlang("strings/tr.lang");
  restotmp("strings/tr.lang", "/fresh/lang.prop");
endif;
