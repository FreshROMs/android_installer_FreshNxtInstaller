# [
INSTALLER="/tmp/install-wizard"
LANG_PROP="/tmp/fresh/lang.prop"
SUMMARY="$INSTALLER/summary.txt"

file_getprop() { grep "^$2=" "$1" | cut -d= -f2-; }

title() {
	local title
	title="$(file_getprop "${LANG_PROP}" "addon.${1}")"

	echo -e "\n"         >> "$SUMMARY"
	echo "<b>$title</b>" >> "$SUMMARY"
}

app() {
	local addon_prop app_name item
	addon_prop="$INSTALLER/${1}.prop"
	app_name="$(file_getprop "$LANG_PROP" "addon.${1}.${2}.title")"
	item="item.0.${3}"

	echo -n "   <#selectbg_g>$app_name:</#> " >> ${SUMMARY}

	if [[ $(file_getprop "$addon_prop" "$item") == '1' ]]
		then file_getprop "$LANG_PROP" "addon.installed" >> ${SUMMARY}
		else file_getprop "$LANG_PROP" "addon.notinstalled" >> ${SUMMARY}
	fi
}
# ]

echo " " > "$SUMMARY"

# Google
echo -n "   <#selectbg_g><b>$(file_getprop "$LANG_PROP" "addon.google"):</b></#> " >> ${SUMMARY}
case $(file_getprop "$INSTALLER/google.prop" "selected.0") in
1) file_getprop "$LANG_PROP" "addon.google.full.title" >> "$SUMMARY" ;;
2) file_getprop "$LANG_PROP" "addon.google.micro.title" >> "$SUMMARY" ;;
3) file_getprop "$LANG_PROP" "addon.google.lite.title" >> "$SUMMARY" ;;
esac

# Bixby
title bixby
app bixby voice 1
app bixby vision 2

# Galaxy Ecosystem
title seamless
app seamless ltw 1
app seamless camerashare 2
app seamless cta 3

# Security
title security
app security checkout 1
app security folder 2
app security wifi 3
app security autoblocker 4

# Augmented Reality
title ar_zone
app ar_zone emoji 1
app ar_zone doodle 2
app ar_zone decopic 3

# Galaxy AI
title gai
app gai wallpaper 1
app gai livetranslate 2
app gai interpreter 3

# More Apps
title misc
app misc dex 1
app misc find 2
app misc suggestions 3
app misc game 4
